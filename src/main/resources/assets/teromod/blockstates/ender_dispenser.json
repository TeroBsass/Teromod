{
  "multipart": [
    {
      "when": { "facing": "down" },
      "apply": { "model": "teromod:block/ender_dispenser", "x": 180 }
    },
    {
      "when": { "facing": "up" },
      "apply": { "model": "teromod:block/ender_dispenser", "x": 90 }
    },
    {
      "when": { "facing": "north" },
      "apply": { "model": "teromod:block/ender_dispenser" }
    },
    {
      "when": { "facing": "south" },
      "apply": { "model": "teromod:block/ender_dispenser", "y": 180 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "teromod:block/ender_dispenser", "y": 270 }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "teromod:block/ender_dispenser", "y": 90 }
    }
  ]
}
